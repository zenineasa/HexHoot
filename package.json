{
    "coprightMessage": "Copyright © 2022-2026 Zenin Easa Panthakkalakath",
    "name": "hexhoot",
    "version": "2.0.0",
    "description": "HexHoot: An Opensource Peer-to-peer Social Network with Zero-Knowledge-Proof based authentication.",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/zenineasa/hexhoot.git"
    },
    "main": "modules/Main/index.js",
    "scripts": {
        "start": "electron .",
        "test": "npm run test:unit && npm run test:capability && npm run test:crypto && npm run test:protocol && npm run test:core && npm run test:e2e",
        "test:unit": "node --test \"test/unit/**/*.test.js\"",
        "test:capability": "node scripts/electron-node.js --test \"test/capability/**/*.test.js\"",
        "test:crypto": "node scripts/electron-node.js --test \"test/crypto/**/*.test.js\"",
        "test:protocol": "node scripts/electron-node.js --test --test-timeout=120000 \"test/protocol/**/*.test.js\"",
        "test:core": "node scripts/electron-node.js --test --test-timeout=120000 \"test/core/**/*.test.js\"",
        "test:e2e": "node scripts/run-e2e.mjs",
        "test:packaged": "node --test --test-timeout=1200000 \"test/packaged/**/*.test.mjs\"",
        "lint": "eslint . && copyright-header --copyrightHolder \"Zenin Easa Panthakkalakath\"",
        "package": "node scripts/package.mjs",
        "distribute": "node scripts/distribute.mjs"
    },
    "author": "Zenin Easa Panthakkalakath (@zenineasa)",
    "license": "AGPLV3",
    "devDependencies": {
        "@electron/asar": "^4.3.4",
        "@electron/fuses": "^2.1.3",
        "@electron/packager": "^20.3.0",
        "copyright-header": "^0.4.6",
        "copyright-regex": "^1.1.6",
        "electron": "^45.5.0",
        "eslint": "^10.15.0",
        "glob": "^14.0.6",
        "hyperdht": "^6.37.0"
    },
    "dependencies": {
        "arptable-js": "^0.0.2",
        "hyperswarm": "^4.17.2",
        "ipv4-range": "^0.0.0",
        "ping": "^1.0.0"
    },
    "engines": {
        "node": ">=22.13.0"
    },
    "allowScripts": {
        "fsevents": false
    }
}
