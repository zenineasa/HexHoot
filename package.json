{
    "coprightMessage": "Copyright © 2022-2024 Zenin Easa Panthakkalakath",
    "name": "hexhoot",
    "version": "1.0.5",
    "description": "HexHoot: An Opensource Peer-to-peer Social Network with Zero-Knowledge-Proof based authentication.",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/zenineasa/hexhoot.git"
    },
    "main": "modules/Main/index.js",
    "scripts": {
        "start": "electron-forge start",
        "test": "npm run test:unit && npm run test:capability && npm run test:core && npm run test:ui",
        "test:unit": "node --test \"test/unit/**/*.test.js\"",
        "test:capability": "node scripts/electron-node.js --test \"test/capability/**/*.test.js\"",
        "test:core": "node scripts/electron-node.js --test --test-timeout=120000 \"test/core/**/*.test.js\"",
        "test:ui": "karma start ./test/karma.conf.js",
        "lint": "eslint . && copyright-header --copyrightHolder \"Zenin Easa Panthakkalakath\"",
        "package": "electron-forge package",
        "make": "electron-forge make"
    },
    "author": "Zenin Easa Panthakkalakath (@zenineasa)",
    "license": "AGPLV3",
    "devDependencies": {
        "@electron-forge/cli": "^8.0.1",
        "@electron-forge/maker-deb": "^8.0.1",
        "@electron-forge/maker-dmg": "^8.0.1",
        "@electron-forge/maker-rpm": "^8.0.1",
        "@electron-forge/maker-squirrel": "^8.0.1",
        "@electron-forge/maker-zip": "^8.0.1",
        "@electron-forge/plugin-fuses": "^8.0.1",
        "@electron/fuses": "^2.1.3",
        "copyright-header": "^0.4.6",
        "copyright-regex": "^1.1.6",
        "electron": "^45.5.0",
        "eslint": "^10.15.0",
        "glob": "^14.0.6",
        "hyperdht": "^6.37.0",
        "karma": "^6.4.4",
        "karma-electron": "^7.3.0",
        "karma-qunit": "^4.2.0",
        "qunit": "^2.20.1"
    },
    "dependencies": {
        "arptable-js": "^0.0.2",
        "ecdh": "^0.2.0",
        "electron-squirrel-startup": "^1.0.1",
        "hyperswarm": "^4.17.2",
        "ipv4-range": "^0.0.0",
        "ping": "^1.0.0"
    },
    "engines": {
        "node": ">=22.13.0"
    },
    "allowScripts": {
        "electron-winstaller@5.4.4": true,
        "fs-xattr@0.3.1": true,
        "macos-alias@0.2.12": true,
        "fsevents": false
    }
}
